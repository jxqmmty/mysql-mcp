# ============================================================================
# mysql-mcp 配置文件说明
# ============================================================================
# 用法：复制本文件为 .env，或直接把下面的键值对写进 MCP 客户端的 env 里。
# 说明：
#   1. 本项目启动时会用 dotenv 自动加载「工作目录」下的 .env 文件；
#   2. 已经存在于进程环境中的变量优先级最高，不会被 .env 覆盖；
#   3. 所有日志只写 stderr，stdout 专门用于 MCP 协议通信。
# ============================================================================


# ----------------------------------------------------------------------------
# 一、连接配置：定义一个名为 default 的连接
# ----------------------------------------------------------------------------
# 【可以整段留空】——只要下面任意一项为空且未设置，服务会以「自动发现模式」启动，
# 转而从你项目自己的数据库配置文件里读取地址/端口/账号/密码，无需手工填写。
# 只有在要连一个「不在项目配置里」的库时，才需要在这里显式填写。
#
# 说明：以下四项（HOST / USER / PASSWORD / DATABASE）只要任意一项有值，
#       就会创建一个名为 default 的连接；未填写项使用括号内的默认值。
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
# 【默认值 root】仅在上面任一变量有值时生效
MYSQL_USER=root
MYSQL_PASSWORD=change-me
MYSQL_DATABASE=app
# 是否启用 SSL/TLS 连接，可选 true / false
MYSQL_SSL=false
# 连接字符集，默认 utf8mb4
MYSQL_CHARSET=utf8mb4
# 建立连接的超时时间（毫秒），默认 10000
MYSQL_CONNECT_TIMEOUT_MS=10000


# ----------------------------------------------------------------------------
# 二、连接配置：额外命名连接（可选，用于同时连多个库）
# ----------------------------------------------------------------------------
# 取值可以是「{ 名称: 配置 } 形式的 JSON 对象」，也可以是「每项自带 name 字段的 JSON 数组」。
# 单个连接的可用字段：
#   host / port / user / password / database / ssl / charset / connectTimeoutMs
#
# 示例（注意：写在一行内，不要换行）：
# MYSQL_CONNECTIONS={"prod":{"host":"10.0.0.5","user":"readonly","password":"xxx","database":"app"},"olap":{"host":"db2.internal","user":"etl","password":"yyy","database":"warehouse"}}
#
# 注意：本变量里不要再定义一个名为 default 的连接，否则与上面的默认连接冲突，启动会报错。

# 工具调用未显式指定 connection 时使用哪个连接。
# 默认规则：存在名为 default 的连接就用它，否则用第一个已配置的连接。
MYSQL_DEFAULT_CONNECTION=default


# ----------------------------------------------------------------------------
# 三、安全策略（默认最小权限）
# ----------------------------------------------------------------------------
# write_query 工具（INSERT / UPDATE / DELETE / REPLACE）的总开关。
# 为 false 时该工具被拒绝执行、并返回明确提示；想允许增删改再改成 true。
MYSQL_ALLOW_WRITE=false
# execute_ddl 工具（CREATE / ALTER / DROP / TRUNCATE / RENAME / ...）的总开关。
# 为 false 时一律拒绝。DROP / TRUNCATE 不可恢复，建议确认目标后再开启。
MYSQL_ALLOW_DDL=false
# 单次查询返回的最大行数，超出会被截断并在结果里标记 truncated。默认 1000（范围 1-100000）
MYSQL_MAX_ROWS=1000
# 单个字符串/二进制字段截断长度，防止超大字段撑爆上下文。默认 4096（范围 64-1000000）
MYSQL_MAX_FIELD_LENGTH=4096
# 客户端查询超时（毫秒），默认 30000（范围 1000-600000）
MYSQL_QUERY_TIMEOUT_MS=30000


# ----------------------------------------------------------------------------
# 四、自动发现
# ----------------------------------------------------------------------------
# discover_connections 工具允许扫描的根目录。默认是「服务启动时的工作目录」。
# 它会在这个目录下查找 .env / .env.local 等文件，解析其中的
# MYSQL_* / DB_* 变量，以及 mysql://user:pass@host:port/db 形式的 DATABASE_URL。
#
# 什么时候需要填：
#   当 MCP 客户端拉起本服务时传进来的工作目录，并不是你的项目目录时才需要显式指定。
#   （实测 opencode 会传它自己所在的项目目录，因此用 opencode 时此项可留空。）
#
# 安全边界：扫描范围被严格限制在此目录内，使用 ../ 逃逸会被直接拒绝。
MYSQL_CONFIG_ROOT=


# ----------------------------------------------------------------------------
# 五、诊断日志
# ----------------------------------------------------------------------------
# 可选值：error | warn | info | debug，默认 info。
# 日志全部输出到 stderr，可在 MCP 客户端的日志里查看。
MYSQL_MCP_LOG_LEVEL=info
